generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  status            String            @default("Active") @map("status")
  phone_number      String            @unique
  user_code         String?
  recovery_code     String?
  two_fa_secret     String?
  is_2fa_verified   Boolean           @default(false)
  password          String
  fp_id             String
  ip                String
  balance           Decimal           @default(0) @db.Decimal(10, 2)
  turn_over         Decimal           @default(0) @db.Decimal(10, 2)
  invited_by        String?           @map("invite_code")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  game_transactions GameTransaction[]
  transactions      Transaction[]
  otp_records       OtpRecord[]
  vouchers Voucher[]
}

model OtpRecord {
  id        Int      @id @default(autoincrement())
  phone     String
  user      User   @relation(fields: [phone], references: [phone_number])
  otp       String
  fingerprint_id String?
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FormSubmissionRecord {
  id        Int     @id @default(autoincrement())
  req_route String
  fp_id     String
  ip        String
  createdAt DateTime @default(now())
}

model Transaction {
  id        Int               @id @default(autoincrement())
  amount    Decimal           @db.Decimal(10, 2)
  type      TransactionType
  trx_id    String?
  sign      String?
  status    TransactionStatus @default(pending)
  user_id   Int
  method    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [user_id], references: [id])
}


model GameTransaction {
  id        Int      @id @default(autoincrement())
  trans_id  String   @unique
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  game_code String?
  user_id   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  sender    String
  receiver  String
  content   String?
  fileUrl   String?
  createdAt DateTime @default(now())
  seen      Boolean  @default(false)
}

enum TransactionStatus {
  pending
  completed
  cancelled
}

enum TransactionType {
  deposit
  withdraw
  bonus
  commission
  salary
}

model Voucher {
  id           Int      @id @default(autoincrement())
  code         String
  amount       Decimal  @db.Decimal(10, 2)
  collected    Boolean  @default(false)
  collected_at DateTime?
  message      String?
  collected_by Int?
  user         User?    @relation(fields: [collected_by], references: [id])
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model BonusList {
  id        Int               @id @default(autoincrement())
  name      String
  deposit   Decimal           @db.Decimal(10, 2)
  bonus     Decimal           @db.Decimal(10, 2)
  turn_over     Decimal           @db.Decimal(10, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CommissionList {
  id        Int               @id @default(autoincrement())
  deposit   Decimal           @db.Decimal(10, 2)
  bet       Decimal           @db.Decimal(10, 2)
  salary    Decimal           @db.Decimal(10, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}